{
  "name": "@cmdless/rpc-sdk",
  "description": "RPC SDK: Allows defining an RPC protocol once, requiring only a connection to create peers of either side. Built on top of vscode-jsonrpc.",
  "version": "0.0.2",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Fluttershy",
    "url": "https://github.com/Fluttershy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdless/electron.git"
  },
  "exports": {
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "import": "./dist/ws/index.js"
    },
    "./ws/node": {
      "types": "./dist/ws/node/index.d.ts",
      "import": "./dist/ws/node/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf dist node_modules/.tmp",
    "build": "tsc -b",
    "test": "node ../../scripts/run-tests.mjs"
  },
  "dependencies": {
    "vscode-jsonrpc": "9.0.2",
    "vscode-ws-jsonrpc": "3.5.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/ws": "8.5.13"
  }
}