{
  "name": "@cmdless/core",
  "description": "Generic process, locking, and service primitives shared across cmdless packages.",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Fluttershy",
    "url": "https://github.com/Fluttershy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdless/electron.git"
  },
  "exports": {
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf dist node_modules/.tmp",
    "build": "tsc -b",
    "test": "node ../../scripts/run-tests.mjs"
  },
  "dependencies": {
    "@lickle/lock": "0.0.1"
  }
}
