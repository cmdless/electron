{
  "name": "@cmdless/ui-sdk",
  "description": "Build cross platform desktop apps built on Electron.",
  "version": "0.0.4",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Fluttershy",
    "url": "https://github.com/Fluttershy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmdless/electron.git"
  },
  "bin": {
    "ui-sdk": "./dist/node/bin.js"
  },
  "exports": {
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf dist node_modules/.tmp",
    "build": "tsc -b",
    "test": "node ../../scripts/run-tests.mjs"
  },
  "dependencies": {
    "@cmdless/rpc-sdk": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "15.0.0",
    "vscode-jsonrpc": "9.0.2",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.5.13"
  }
}